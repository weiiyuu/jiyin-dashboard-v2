{
  "name": "jiyin-dashboard-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure:stage5.2": "RUN_STAGE52_PERF=1 vitest run tests/stage52-performance.test.ts --reporter=verbose",
    "collector:idle": "tsx src/server/collector/idle.ts"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
