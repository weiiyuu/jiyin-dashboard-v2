# Public example only. Do not place enterprise origins, credentials, tokens, or CA paths here.
APP_TIMEZONE=Asia/Taipei
DATABASE_PATH=data/jiyin-dashboard.sqlite
STALE_AFTER_SECONDS=420

# Live 使用者請填入相同的企業 HTTPS Origin（含 Port）
ENTERPRISE_API_ORIGIN=
ENTERPRISE_API_ALLOWED_ORIGINS=

# 目前經核准企業 API 的連線設定
ENTERPRISE_TLS_MODE=allowlisted_self_signed
ENTERPRISE_API_AUTH_MODE=none
API_TIMEOUT_MS=20000
API_MAX_RESPONSE_BYTES=2097152
