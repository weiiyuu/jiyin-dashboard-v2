# Public example only. Do not place enterprise origins, credentials, tokens, or CA paths here.
APP_TIMEZONE=Asia/Taipei
DATABASE_PATH=/app/data/jiyin-dashboard.sqlite
PROVIDER_MODE=DEMO
STALE_AFTER_SECONDS=420

